{
    "openapi": "3.0.0",
    "info": {
        "title": "Livraria Virtual API",
        "version": "1.0.0",
        "description": "API REST para gerenciamento de livros e clientes"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Servidor de desenvolvimento"
        }
    ],
    "paths": {
        "/auth/login": {
      "post": {
        "summary": "Login de usuário",
        "description": "Realiza o login do usuário",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              },
              "example": {
                  "user_email": "exemplo@email.com",
                  "user_password": "Senha@123"
                }
              }
            }
          },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso"
          },
          "401": {
            "description": "Email ou senha inválidos"
          },
          "404": {
            "description": "Usuário não encontrado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh Token de usuário",
        "description": "Realiza o refresh token do usuário",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "Token de refresh do usuário",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNzIwNDYyMzk1fQ.SpY5s8Y7y9m0v6t8w4y2x0z1q3r5s7t9u1v3w5x7y9z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token de refresh realizado com sucesso"
          },
          "401": {
            "description": "Token de refresh inválido"
          },
          "400": {
            "description": "Senha inválida"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary":"Logout de usuário",
        "description": "Realiza o logout do usuário",
        "tags": ["Autenticação"],
        "responses": {
          "200": {
            "description": "Logout realizado com sucesso!"
          },
          "401": {
            "description": "Token de refresh inválido"
          },
          "500": {
            "description":"Erro interno do servidor"
          }
        }
      }
    }
    },
    "components":{
      "schemas": {
        "Login": {
          "properties": {
            "user_email": {
              "type": "string",
              "description": "Email do usuário",
              "example": "exemplo@dominio.com"
            },
            "user_password": {
              "type": "string"
            }
          }
        },
        "RefreshToken": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string"
            }
          }
        }
      },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}